# Normalize line endings: LF in the repository and the working tree for text
# files, so checkouts are consistent across platforms and Git stops warning
# about LF/CRLF conversion on Windows.
* text=auto eol=lf

# Windows batch scripts must keep CRLF.
*.bat text eol=crlf

# Binary assets — never convert these.
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
